# MDM API
MDM_TOKEN_URL=https://mdm.example.com/token
MDM_KEY=<replace-with-mdm-api-key>
MDM_EMPLOYEE_URL=https://mdm.example.com/employees
MDM_QUERY_SIZE=100
MDM_ORIGINAL_HIRE_DATE=2026-01-01

# RMS API
RMS_TOKEN_URL=https://rms.example.com/token
RMS_USER=<replace-with-rms-username>
RMS_PASSWORD=<replace-with-rms-password>
RMS_EMPLOYEE_URL=https://rms.example.com/employees
RMS_EMPLOYEE_NFC_URL=https://rms.example.com/employee-nfc
RMS_UPDATE_ENABLED=false

# Set to prod for production email formatting; otherwise emails use the dev. prefix.
ENVIRONMENT=dev

# Email Center notifications
EMAIL_TOKEN_URL=https://email.example.com/oauth2/token
EMAIL_TOKEN_SCOPE=<replace-with-email-token-scope>
EMAIL_TOKEN_CLIENT_ID=<replace-with-email-client-id>
EMAIL_TOKEN_CLIENT_SECRET=<replace-with-email-client-secret>
EMAIL_API_URL=https://email.example.com/api/notifications
# Required recipient for error emails, for example an operations mailbox.
default_to=<replace-with-notification-recipient>

# Optional: used when Notification.send_error_notification() is called without these arguments.
# default_subject=MDM 2.0 to RMS API Error
# default_body=An error occurred while processing employee data.

# Optional email token request overrides. Defaults to client_credentials and
# application/x-www-form-urlencoded when omitted.
# EMAIL_TOKEN_GRANT_TYPE=client_credentials
# EMAIL_TOKEN_CONTENT_TYPE=application/x-www-form-urlencoded

# Optional custom CA bundle. On Windows, system ROOT and CA stores are used by default.
# MDM_CA_BUNDLE=C:/certs/company-ca-bundle.pem
